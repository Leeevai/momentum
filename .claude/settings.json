{
  "extraKnownMarketplaces": {
    "indie-apple-stack": {
      "source": {
        "source": "github",
        "repo": "rshankras/claude-code-apple-skills"
      }
    }
  },
  "enabledPlugins": {
    "apple-skills@indie-apple-stack": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py"
          }
        ]
      }
    ]
  }
}
